{
  "name": "echoris",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node ../Sheets/tools/csv_to_locale.mjs",
    "dev:ko": "vite --mode ko",
    "predev:ko": "node ../Sheets/tools/csv_to_locale.mjs",
    "dev:en": "vite --mode en",
    "predev:en": "node ../Sheets/tools/csv_to_locale.mjs",
    "prebuild": "node ../Sheets/tools/csv_to_locale.mjs && node ../Sheets/tools/validate.mjs",
    "build": "tsc && vite build",
    "build:en": "tsc && vite build --mode en",
    "build:ko": "tsc && vite build --mode ko",
    "preview": "vite preview",
    "i18n:build": "node ../Sheets/tools/csv_to_locale.mjs",
    "merge-ldtk": "node ../tools/merge-ldtk.mjs",
    "ase:watch": "node scripts/ase-watch.mjs",
    "marketing": "node ../Documents/Plan/marketing/server.js"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "@pixi/tilemap": "^4.1.0",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "puppeteer": "^25.0.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}