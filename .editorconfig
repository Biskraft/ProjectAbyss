# ECHORIS .editorconfig
# 목적: 모든 텍스트 파일을 BOM 없는 UTF-8 / LF 로 강제 — CP949 인코딩 손상 재발 방지.
# .gitattributes 가 git 체크인/체크아웃의 eol·text 를 다룬다면,
# .editorconfig 는 에디터가 파일을 저장할 때의 charset(UTF-8)을 강제한다.
# (이번 한글 깨짐은 작업 트리에서 CP949 로 저장돼 발생했으므로, 에디터 측 방어가 핵심.)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.md]
charset = utf-8
end_of_line = lf
# 마크다운은 줄 끝 공백(강제 줄바꿈)이 의미가 있어 trim 하지 않음
trim_trailing_whitespace = false

[*.{ts,js,mjs,json,csv,yml,yaml}]
charset = utf-8
end_of_line = lf
